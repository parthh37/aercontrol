<?xml version="1.0" encoding="utf-8"?>
<Page
    x:Class="AerControl.App.Pages.SprayPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:AerControl.App.Pages">

    <Grid Padding="28,12,28,20" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <InfoBar x:Name="UpdateBar" Grid.Row="0" Severity="Informational" IsClosable="True" IsOpen="False"
                 Title="Update available">
            <InfoBar.ActionButton>
                <Button Content="Download" Click="OnDownloadUpdateClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="32">
            <Button
                x:Name="SprayButton"
                Width="168" Height="168"
                CornerRadius="84"
                Style="{StaticResource AccentButtonStyle}"
                Click="OnSprayClick"
                ToolTipService.ToolTip="Spray now">
                <Grid>
                    <StackPanel x:Name="SprayLabel" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <FontIcon x:Name="SprayGlyph" Glyph="&#xE945;" FontSize="44" />
                        <TextBlock Text="Spray" FontSize="22" FontWeight="SemiBold" HorizontalAlignment="Center" />
                    </StackPanel>
                    <ProgressRing x:Name="SprayProgress" Width="56" Height="56" IsActive="False" Foreground="White" />
                </Grid>
            </Button>

            <StackPanel Spacing="10" VerticalAlignment="Center" MaxWidth="420">
                <TextBlock x:Name="DeviceNameText" Style="{StaticResource SubtitleTextBlockStyle}" Text="No device selected" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Border CornerRadius="12" Padding="10,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <Ellipse x:Name="StatusDot" Width="9" Height="9" VerticalAlignment="Center" />
                            <TextBlock x:Name="StatusText" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="10,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            ToolTipService.ToolTip="Battery. The official app warns below 2.8 V and asks for new batteries below 2.7 V.">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xE83F;" FontSize="14" />
                            <TextBlock x:Name="BatteryText" Text="—" />
                        </StackPanel>
                    </Border>
                    <Border CornerRadius="12" Padding="10,4" Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                            ToolTipService.ToolTip="Sprays remaining in refill">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon Glyph="&#xEB42;" FontSize="14" />
                            <TextBlock x:Name="RefillText" Text="—" />
                        </StackPanel>
                    </Border>
                </StackPanel>
                <TextBlock x:Name="LastSprayText" Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                <TextBlock x:Name="BatteryHint" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <TextBlock x:Name="RefillHint" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCautionBrush}"
                           Text="The device has counted more sprays than a can holds. Just put in a new can? Press “Reset refill…”." />
                <TextBlock x:Name="ErrorText" TextWrapping="Wrap" Visibility="Collapsed"
                           Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Name="RefreshStatusButton" Content="Refresh status" Click="OnRefreshStatusClick" />
                    <Button x:Name="ResetRefillButton" Content="Reset refill…" Click="OnResetRefillClick" />
                    <Button x:Name="ConnectButton" Content="Connect" Click="OnConnectClick" />
                    <Button x:Name="DisconnectButton" Content="Disconnect" Click="OnDisconnectClick" />
                </StackPanel>
            </StackPanel>
        </StackPanel>

        <Grid Grid.Row="2" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <TextBlock Text="History" Style="{StaticResource BodyStrongTextBlockStyle}" VerticalAlignment="Center" />
            <Button Content="Clear" HorizontalAlignment="Right" Click="OnClearHistoryClick" />
            <ListView x:Name="HistoryList" Grid.Row="1" SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:HistoryItem">
                        <Grid ColumnSpacing="14" Padding="0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="20" />
                                <ColumnDefinition Width="170" />
                                <ColumnDefinition Width="90" />
                                <ColumnDefinition Width="44" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="{x:Bind Glyph}" Foreground="{x:Bind Brush}" FontSize="14" />
                            <TextBlock Grid.Column="1" Text="{x:Bind Time}" />
                            <TextBlock Grid.Column="2" Text="{x:Bind Source}" />
                            <TextBlock Grid.Column="3" Text="{x:Bind MessageNumber}" />
                            <TextBlock Grid.Column="4" Text="{x:Bind Details}" TextTrimming="CharacterEllipsis"
                                       Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                       ToolTipService.ToolTip="{x:Bind Details}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
    </Grid>
</Page>
