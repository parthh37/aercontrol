<Project>
  <PropertyGroup>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Lets the windows-TFM projects build (not run) on macOS/Linux, e.g. for quick checks. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Version>1.5.0</Version>
    <Company>AerControl</Company>
    <Product>AerControl</Product>
  </PropertyGroup>
  <PropertyGroup>
    <WindowsTfm>net8.0-windows10.0.19041.0</WindowsTfm>
  </PropertyGroup>
</Project>
